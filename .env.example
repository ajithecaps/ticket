# Copy to .env and edit.

APP_NAME="Developer Ticket System"
DEBUG=false

# SQLite for local use; PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg2://tickets:tickets@localhost:5432/tickets
DATABASE_URL=sqlite:///./tickets.db

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=10
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.com,.scr,.msi,.dll

# Comma separated list, or * for any origin
CORS_ORIGINS=*

# Created on first start when no admin exists yet
FIRST_ADMIN_NAME=Administrator
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

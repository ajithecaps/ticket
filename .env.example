# Copy to .env and edit.

APP_NAME="Grandesk"
DEBUG=false

# SQLite for local use; PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg2://tickets:tickets@localhost:5432/tickets
DATABASE_URL=sqlite:///./tickets.db

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=10
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.com,.scr,.msi,.dll

# Comma separated list, or * for any origin
CORS_ORIGINS=*

# Created on first start when no admin exists yet
FIRST_ADMIN_NAME=Administrator
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# Address people open the app at - used for ticket links in Slack messages
APP_BASE_URL=http://localhost:8000
# Time zone for the daily summary and dates in Slack
TIMEZONE=Asia/Kolkata

# ---- Slack -------------------------------------------------------------------
# Option 1 (simplest): an Incoming Webhook for the channel
SLACK_WEBHOOK_URL=
# Option 2 (real @mentions): a bot token with chat:write + users:read.email, and the channel ID
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Which notifications to mirror: all | none | comma list of
# ticket_created,assigned,unassigned,status_changed,ticket_updated,comment,mention,project_member,overdue
SLACK_NOTIFY_TYPES=all
# Daily pending-tickets summary ("HH:MM" in TIMEZONE; leave empty to turn off)
SLACK_DAILY_SUMMARY_TIME=10:00
SLACK_DAILY_SUMMARY_DAYS=mon,tue,wed,thu,fri,sat,sun

# Background jobs (overdue alerts + daily summary). With several API hosts, enable on one only.
SCHEDULER_ENABLED=true
OVERDUE_CHECK_MINUTES=15

# Chat calls (WebRTC). Calls need the app on https:// (or localhost).
CHAT_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay (coturn) for strict firewalls / mobile networks
CHAT_TURN_URL=
CHAT_TURN_USERNAME=
CHAT_TURN_CREDENTIAL=
CHAT_MAX_CALL_PEOPLE=8

# Folder holding the desktop app installers offered on the "Desktop app" page (see README).
DESKTOP_DIR=desktop-builds
